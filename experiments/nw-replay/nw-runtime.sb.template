(version 1)
(deny default)
; IP networking remains denied by default. Only task-private Unix IPC is allowed.
(deny iokit-open)
(deny iokit-set-properties)
(allow process-fork)
(allow sysctl-read)
(allow file-read*
  (literal "/")
  (literal "/System/Volumes/Preboot/Cryptexes/OS")
  (literal "/System/Volumes/Preboot/Cryptexes/Rosetta")
  (literal "/dev/fd")
  (literal "/dev/urandom")
  (literal "/dev/random")
  (subpath "/usr/share/icu")
  (subpath "@PRIVATE_TMP@")
  (subpath "/System/Library")
  (subpath "/System/Volumes/Preboot/Cryptexes/OS/System/Library")
  (subpath "/System/Volumes/Preboot/Cryptexes/Rosetta/System/Library")
  (subpath "/System/Volumes/Preboot/Cryptexes/Incoming/OS/System/Library")
  (subpath "/usr/lib")
  (subpath "/Library/Apple")
  (subpath "/Library/Fonts")
  (subpath "/Library/Preferences")
  (subpath "/private/var/db/dyld")
  (subpath "/private/var/db/oah")
  (subpath "@RUNTIME_ROOT@")
  (subpath "@REPLAY_ROOT@"))
(allow file-write*
  (subpath "@REPLAY_ROOT@/output")
  (subpath "@REPLAY_ROOT@/profile")
  (subpath "@REPLAY_ROOT@/tmp"))
(allow file-write* (subpath "@PRIVATE_TMP@"))
(allow network-bind (local unix-socket (subpath "@PRIVATE_TMP@")))
(allow network-outbound (remote unix-socket (subpath "@PRIVATE_TMP@")))
(allow network-inbound (local unix-socket (subpath "@PRIVATE_TMP@")))
(allow file-issue-extension
  (require-all
    (extension-class "com.apple.app-sandbox.read")
    (subpath "@RUNTIME_ROOT@")))
(allow process-exec
  (literal "@RUNTIME_ROOT@/nwjs-sdk-v0.31.1-osx-x64/nwjs.app/Contents/Versions/67.0.3396.79/nwjs Helper.app/Contents/MacOS/nwjs Helper")
  (literal "@RUNTIME_ROOT@/nwjs-sdk-v0.31.1-osx-x64/nwjs.app/Contents/MacOS/nwjs")
  (literal "@RUNTIME_ROOT@/nwjs-sdk-v0.31.1-osx-x64/nwjs.app/Contents/Frameworks/nwjs Helper.app/Contents/MacOS/nwjs Helper"))
(allow process-exec
  (literal "@RUNTIME_ROOT@/nwjs-sdk-v0.31.1-osx-x64/nwjs.app/Contents/Versions/67.0.3396.79/nwjs Framework.framework/Versions/A/Helpers/crashpad_handler"))
(allow file-read-metadata
  (literal "/usr")
  (literal "/usr/libexec")
  (literal "/usr/libexec/rosetta")
  (literal "/usr/libexec/rosetta/runtime")
  (literal "/private")
  (literal "/private/tmp")
  (literal "/dev")
  (literal "/etc")
  (literal "/var")
  (literal "/System/Volumes/Data")
  (literal "/System/Cryptexes/App")
  (literal "/usr/share/icu/icudt78l.dat")
  (literal "/System")
  (literal "/System/Cryptexes")
  (literal "/System/Cryptexes/OS")
  (literal "/System/Cryptexes/Rosetta")
  (literal "/System/Volumes")
  (literal "/System/Volumes/Preboot")
  (literal "/System/Volumes/Preboot/Cryptexes")
  (literal "/System/Volumes/Preboot/Cryptexes/OS")
  (literal "/System/Volumes/Preboot/Cryptexes/OS/System")
  (literal "/System/Volumes/Preboot/Cryptexes/Rosetta")
  (literal "/System/Volumes/Preboot/Cryptexes/Rosetta/System")
  (literal "/System/Volumes/Preboot/Cryptexes/Incoming")
  (literal "/System/Volumes/Preboot/Cryptexes/Incoming/OS")
  (literal "/System/Volumes/Preboot/Cryptexes/Incoming/OS/System")
  (literal "/Library")
  (literal "/Users")
  (literal "${HOME}")
  (literal "${HOME}/opt")
  (literal "${HOME}/opt/Codex")
  (literal "${HOME}/opt/Codex/2026-10-23")
  (literal "${WORKSPACE}")
  (literal "${WORKSPACE}/work"))
(allow mach-lookup
  (global-name "com.apple.WindowServer.active")
  (global-name "com.apple.windowserver.active")
  (global-name "com.apple.cfprefsd.daemon")
  (global-name "com.apple.cfprefsd.agent")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.oahd"))
(allow mach-lookup
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.logd")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.distributed_notifications@Uv3")
  (global-name "com.apple.CARenderServer")
  (global-name "com.apple.CoreServices.coreservicesd"))
